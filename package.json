{
  "name": "forgepilot",
  "displayName": "ForgePilot",
  "description": "AI coding agent for VS Code — Team Beacon, TrueFoundry Forge-a-thon 2026–27",
  "version": "0.0.1",
  "publisher": "team-beacon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shriyasshh/Team-Beacon-vscode.git"
  },
  "engines": {
    "vscode": "^1.142.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forgepilot.activate",
        "title": "ForgePilot: Activate"
      }
    ]
  },
  "scripts": {
    "compile": "npm run typecheck && node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepackage": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.142.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "@vscode/vsce": "^3.0.0"
  }
}

